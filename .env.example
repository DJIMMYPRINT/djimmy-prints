# Supabase project used to store WhatsApp orders (server-only — service
# role key must never be prefixed NEXT_PUBLIC_ and never sent to the browser)
SUPABASE_URL=https://ivxvzyokijsatdlonpec.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Meta WhatsApp Business Platform (Cloud API) app, from the Meta App Dashboard
# WhatsApp > Configuration page. WHATSAPP_VERIFY_TOKEN is a string you invent
# yourself and enter in both places when subscribing the webhook.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
