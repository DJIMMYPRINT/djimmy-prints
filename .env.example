# Réponses automatiques aux messages privés et commentaires Instagram /
# Facebook (voir AUTO-REPONSES.md et la console /auto-reponses).
#
# Sans ces variables le site fonctionne normalement : /api/social/webhook
# refuse simplement les évènements (503), rien d'autre ne change.
#
# NE JAMAIS préfixer ces valeurs par NEXT_PUBLIC_ : ce sont des secrets.
META_VERIFY_TOKEN=
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=
# Ids de la Page Facebook et du compte Instagram pro : facultatifs, ils évitent
# que le robot réponde à ses propres commentaires.
META_PAGE_ID=
META_IG_ID=
# 'off' = mode simulation : les réponses sont calculées et tracées dans les
# logs, mais rien n'est publié. À utiliser le temps de relire le robot.
SOCIAL_AUTOREPLY=
