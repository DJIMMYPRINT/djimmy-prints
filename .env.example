# Copy to .env.local (gitignored) for local dev, and set the same values
# as environment variables in your deployment (e.g. Vercel project settings).

# Supabase project URL — already public (used for the image storage bucket),
# see lib/constants.js SUPABASE_IMG_BASE.
SUPABASE_URL=https://ivxvzyokijsatdlonpec.supabase.co

# Supabase service role key — SECRET. Found in Supabase dashboard →
# Project Settings → API → service_role key. Server-only: used by API
# routes and admin pages to read/write the orders table, bypassing RLS.
# Never expose this with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# Shared password for the internal /admin back-office (staff only, not a
# customer-facing login). Pick something long and random.
ADMIN_PASSWORD=

# Random long string used to sign the admin session cookie. Generate with:
# openssl rand -hex 32
ADMIN_SESSION_SECRET=
